FROM ultralytics/ultralytics:latest-jetson-jetpack6

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install system dependencies needed for PyAV compilation
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libavformat-dev libavcodec-dev libavdevice-dev libavutil-dev libswscale-dev libswresample-dev libavfilter-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install the dependencies required for fw-edge (gRPC, MQTT, telemetry, video decoding)
RUN pip install --upgrade pip && \
    pip install grpcio protobuf paho-mqtt av nats-py
